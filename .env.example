# Used by the browser import and the server building-generation endpoint.
# Browser API credentials are visible to users of the built application.
Dev_Api_Key=
Maps_Api_Key=

# Standalone generation API (npm run api). Separate from the iway API keys above.
PLANNER_API_HOST=127.0.0.1
PLANNER_API_PORT=3001
PLANNER_API_KEY=
# Comma-separated browser origins, for example http://localhost:5173
PLANNER_API_CORS_ORIGINS=
